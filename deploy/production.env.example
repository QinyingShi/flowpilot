PROJECT_ENV=production
PROJECT_MEMBERSHIP_MODE=invite_only
PROJECT_SEED_DEMO_DATA=false

# Generate a unique value with at least 32 random characters. Use the same
# value for the Sites web proxy and this API service.
PROJECT_API_PROXY_SECRET=replace-with-a-unique-random-value-of-at-least-32-characters
PROJECT_BOOTSTRAP_ADMIN_EMAIL=admin@example.com

# The public Sites origin only; do not include paths or wildcards.
PROJECT_CORS_ORIGINS=https://your-flowpilot-site.example

# These paths are mounted from the persistent /data volume by Compose.
PROJECT_DB_PATH=/data/flowpilot.db
PROJECT_UPLOAD_PATH=/data/uploads

# Set to the ingress proxy address/range understood by Uvicorn. Keep the
# default when the container is reached directly without a reverse proxy.
FORWARDED_ALLOW_IPS=127.0.0.1
PROJECT_ACCESS_LOG=true

# Set true only when API and the scheduler must share one local persistent disk
# (for example, a single-service Render deployment). Keep false with Compose,
# where the dedicated inspection-worker service runs the scheduler.
PROJECT_EMBED_INSPECTION_WORKER=false
PROJECT_INSPECTION_POLL_SECONDS=30

# Optional GitHub live connector.
GIT_ACCESS_TOKEN=
GITHUB_API_VERSION=2026-03-10
GITHUB_ALLOWED_HOSTS=

# Optional OpenAI requirement-document analysis.
PROJECT_AI_REQUIREMENTS_ENABLED=false
OPENAI_API_KEY=
PROJECT_AI_MODEL=gpt-5.4-mini
PROJECT_AI_TIMEOUT_SECONDS=90
PROJECT_AI_PDF_DETAIL=auto
