# Python API used by the Vinext proxy.
PROJECT_API_BASE_URL=http://127.0.0.1:8000
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# Required on both the web proxy and Python service in production.
PROJECT_API_PROXY_SECRET=replace-with-a-long-random-secret

# Production defaults to invite-only membership unless explicitly set to open.
PROJECT_ENV=development
PROJECT_MEMBERSHIP_MODE=open
# Required for the first production administrator.
PROJECT_BOOTSTRAP_ADMIN_EMAIL=admin@example.com

# Local SQLite path. Replace the persistence layer before multi-instance deployment.
PROJECT_DB_PATH=backend/data/project_command_center.db
PROJECT_CORS_ORIGINS=http://localhost:3001,http://127.0.0.1:3001

# Server-side requirement document analysis. Keep the API key out of the browser.
PROJECT_AI_REQUIREMENTS_ENABLED=false
OPENAI_API_KEY=
PROJECT_AI_MODEL=gpt-5.4-mini
PROJECT_AI_TIMEOUT_SECONDS=90
# auto balances cost and visual detail; use high for dense scanned PDFs.
PROJECT_AI_PDF_DETAIL=auto
